            "en": "Toulouse Métropole",
            "fr": "Toulouse Métropole",
            "de": "Toulouse Métropole",
            "es": "Toulouse Métropole"
          }
        },
        {
          "value": "rennes",
          "label": {
            "en": "Rennes Métropole (next 6 days)",
            "fr": "Rennes Métropole (6 prochains jours)",
            "de": "Rennes Métropole (nächste 6 Tage)",
            "es": "Rennes Métropole (próximos 6 días)"
