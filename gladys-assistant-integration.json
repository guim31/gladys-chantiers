      "default": "500",
      "label": {
        "en": "Around the house",
        "fr": "Autour de la maison",
        "de": "Rund ums Haus",
        "es": "Alrededor de la casa"
      },
      "description": {
        "en": "A zone with the worksites within this distance of the house located in Gladys.",
        "fr": "Une zone avec les chantiers à cette distance de la maison localisée dans Gladys.",
        "de": "Eine Zone mit den Baustellen in diesem Umkreis des in Gladys verorteten Hauses.",
        "es": "Una zona con las obras a esta distancia de la casa ubicada en Gladys."
      },
      "options": [
        {
          "value": "0",
          "label": {
            "en": "Off",
            "fr": "Désactivé",
            "de": "Aus",
            "es": "Desactivado"
          }
        },
        {
          "value": "200",
          "label": {
            "en": "200 m",
            "fr": "200 m",
            "de": "200 m",
            "es": "200 m"
          }
        },
        {
          "value": "500",
