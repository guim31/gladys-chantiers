{
  "manifest_version": 1,
  "type": "device",
  "name": "Chantiers",
  "description": {
    "en": "Roadworks disrupting traffic near you, from French city open data (Paris, Lyon, Toulouse…).",
    "fr": "Les chantiers qui perturbent la circulation près de chez vous (open data : Paris, Lyon, Toulouse…).",
    "de": "Baustellen mit Verkehrsbehinderung in deiner Nähe, aus Open Data französischer Städte.",
    "es": "Obras que perturban el tráfico cerca de usted, datos abiertos de ciudades francesas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-chantiers:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-chantiers/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "countries": ["FR"],
  "keywords": [
    "chantiers",
    "travaux",
    "roadworks",
    "Paris",
    "Lyon",
    "Toulouse",
    "Rennes",
    "Tours",
    "Angers",
    "voirie"
  ],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Tick your cities, choose a radius around the house and/or type streets, then save: the zones appear in the Discover tab. Add the ones you want to Gladys. Read twice a day, no account, no key.",
        "fr": "Cochez vos villes, choisissez un rayon autour de la maison et/ou tapez des rues, puis enregistrez : les zones apparaissent dans l'onglet Découverte. Ajoutez celles qui vous intéressent à Gladys. Lu deux fois par jour, sans compte ni clé.",
        "de": "Kreuze deine Städte an, wähle einen Umkreis ums Haus und/oder gib Straßen ein und speichere: Die Zonen erscheinen im Tab „Entdecken“. Füge die gewünschten zu Gladys hinzu. Zweimal täglich gelesen, kein Konto, kein Schlüssel.",
        "es": "Marque sus ciudades, elija un radio alrededor de la casa y/o escriba calles y guarde: las zonas aparecen en la pestaña Descubrir. Añada a Gladys las que le interesen. Leído dos veces al día, sin cuenta ni clave."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-chantiers/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide de configuration",
            "de": "Einrichtungsanleitung",
            "es": "Guía de configuración"
          }
        }
      ]
    },
    {
      "key": "cities",
      "type": "multi_select",
      "label": {
        "en": "Cities",
        "fr": "Villes",
        "de": "Städte",
        "es": "Ciudades"
      },
      "description": {
        "en": "Worksites published in open data and kept up to date. Others: see the guide.",
        "fr": "Chantiers publiés en open data et tenus à jour. Autres villes : voir le guide.",
        "de": "Als Open Data veröffentlichte, aktuelle Baustellen. Andere Städte: siehe Anleitung.",
        "es": "Obras publicadas en datos abiertos y actualizadas. Otras ciudades: vea la guía."
      },
      "options": [
        {
          "value": "paris",
          "label": {
            "en": "Paris",
            "fr": "Paris",
            "de": "Paris",
            "es": "Paris"
          }
        },
        {
          "value": "lyon",
          "label": {
