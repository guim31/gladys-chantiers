            "en": "2 km",
            "fr": "2 km",
            "de": "2 km",
            "es": "2 km"
          }
        }
      ]
    },
    {
      "key": "streets",
      "type": "string",
      "label": {
        "en": "Streets to follow",
        "fr": "Rues à suivre",
        "de": "Zu verfolgende Straßen",
        "es": "Calles a seguir"
      },
      "description": {
        "en": "One zone per street: part of its name, separated by commas, 3 letters at least, 10 streets at most. Accents and case do not matter.",
        "fr": "Une zone par rue : une partie de son nom, séparée par des virgules, 3 lettres au moins, 10 rues au plus. Accents et majuscules indifférents.",
        "de": "Eine Zone pro Straße: ein Teil ihres Namens, durch Kommas getrennt, mindestens 3 Buchstaben, höchstens 10 Straßen. Akzente und Großschreibung egal.",
        "es": "Una zona por calle: parte de su nombre, separada por comas, 3 letras como mínimo, 10 calles como máximo. Sin importar acentos ni mayúsculas."
      },
      "placeholder": {
        "en": "Rue de Vaugirard, Avenue Esquirol",
        "fr": "Rue de Vaugirard, Avenue Esquirol",
        "de": "Rue de Vaugirard, Avenue Esquirol",
        "es": "Rue de Vaugirard, Avenue Esquirol"
      }
    },
    {
      "key": "language",
      "type": "select",
      "default": "fr",
      "label": {
        "en": "Language of names and messages",
        "fr": "Langue des noms et messages",
        "de": "Sprache der Namen und Nachrichten",
        "es": "Idioma de nombres y mensajes"
      },
      "description": {
        "en": "Feature names are fixed when a device is added. The worksites stay in French, as published.",
        "fr": "Les noms des fonctionnalités sont figés à l'ajout de l'appareil. Les chantiers restent en français, comme publiés.",
        "de": "Die Namen der Funktionen werden beim Hinzufügen festgelegt. Die Baustellen bleiben auf Französisch, wie veröffentlicht.",
        "es": "Los nombres de las funciones se fijan al añadir el dispositivo. Las obras quedan en francés, tal como se publican."
      },
      "options": [
        {
          "value": "en",
          "label": {
